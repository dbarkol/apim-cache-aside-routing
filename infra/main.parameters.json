{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "gpt4oMiniModelVersion": {
      "value": "${GPT4O_MINI_MODEL_VERSION}"
    },
    "roundRobinModelName": {
      "value": "${ROUND_ROBIN_MODEL_NAME}"
    },
    "roundRobinModelVersion": {
      "value": "${ROUND_ROBIN_MODEL_VERSION}"
    },
    "priorityModelVersion": {
      "value": "${PRIORITY_MODEL_VERSION}"
    },
    "miniPrimaryCircuitBreakerFailureCount": {
      "value": "${MINI_PRIMARY_CIRCUIT_BREAKER_FAILURE_COUNT=3}"
    },
    "miniPrimaryCircuitBreakerSamplingInterval": {
      "value": "${MINI_PRIMARY_CIRCUIT_BREAKER_SAMPLING_INTERVAL=PT1M}"
    },
    "miniPrimaryCircuitBreakerTripDuration": {
      "value": "${MINI_PRIMARY_CIRCUIT_BREAKER_TRIP_DURATION=PT30S}"
    },
    "profileCacheTtlSeconds": {
      "value": "${PROFILE_CACHE_TTL_SECONDS=300}"
    },
    "profileLookupTimeoutSeconds": {
      "value": "${PROFILE_LOOKUP_TIMEOUT_SECONDS=3}"
    },
    "tokenLimitPolicyVariant": {
      "value": "${TOKEN_LIMIT_POLICY_VARIANT=azure-openai-token-limit}"
    }
  }
}
