<policies>
  <!--
    Gateway Routing Profile pipeline:
    1. Validate the request's test Profile Key adapter.
    2. Resolve compact normalized JSON from cache or Table Storage.
    3. Apply the row's BackendId and MaxTpm to this request.

    This file intentionally mirrors azure-openai-token-limit.xml except for the
    token-limit policy element so the stored profile contract remains unchanged.
  -->
  <inbound>
    <base />
    <!-- Test adapter: production gateways should derive the Profile Key from trusted identity and request context. -->
    <set-variable name="profileKey" value='@(context.Request.Headers.GetValueOrDefault("x-profile-key", ""))' />
    <!-- Guard the lookup pipeline so only supported Profile Key syntax can reach cache or Table Storage. -->
    <choose>
      <!-- Condition: the header is missing or contains characters/length outside the Profile Key contract. -->
      <when condition='@(!System.Text.RegularExpressions.Regex.IsMatch((string)context.Variables["profileKey"], "^[A-Za-z0-9._-]{1,128}$"))'>
        <return-response>
          <set-status code="400" reason="Bad Request" />
          <set-header name="Content-Type" exists-action="override">
            <value>application/json</value>
          </set-header>
          <set-body>@("{\"error\":{\"code\":\"InvalidRequest\",\"message\":\"The request is invalid.\",\"correlationId\":\"" + context.RequestId + "\"}}")</set-body>
        </return-response>
      </when>
    </choose>
    <!-- Resolve the compact, validated profile from APIM's built-in cache. -->
    <cache-lookup-value key='@((string)context.Variables["profileKey"])' variable-name="cachedProfile" caching-type="internal" />
    <!-- Select the fast cache-hit path or the protected Table Storage miss path. -->
    <choose>
      <!-- Condition: APIM returned a previously validated, normalized profile for this key. -->
      <when condition='@(context.Variables.ContainsKey("cachedProfile"))'>
        <!-- Cache hits already contain only the normalized fields produced by the miss path. -->
        <set-variable name="profileCacheOutcome" value="hit" />
        <set-variable name="normalizedProfile" value='@((string)context.Variables["cachedProfile"])' />
      </when>
      <!-- Fallback: no cache value exists, so rate-limit and perform one authoritative Table point read. -->
      <otherwise>
        <!-- On a miss, point-read the version-one Table entity with APIM's managed identity. -->
        <set-variable name="profileCacheOutcome" value="miss" />
        <rate-limit-by-key calls="10" renewal-period="60" counter-key='@((string)context.Variables["profileKey"])' id="profile-miss-rate-limit" />
        <send-request mode="new" response-variable-name="profileResponse" timeout="{{ProfileLookupTimeoutSeconds}}" ignore-error="true">
          <set-url>@("{{ProfileTableEndpoint}}/{{ProfileTableName}}(PartitionKey='profiles-v1',RowKey='" + (string)context.Variables["profileKey"] + "')")</set-url>
          <set-method>GET</set-method>
          <set-header name="Accept" exists-action="override">
            <value>application/json;odata=nometadata</value>
          </set-header>
          <set-header name="x-ms-version" exists-action="override">
            <value>2019-02-02</value>
          </set-header>
          <authentication-managed-identity resource="https://storage.azure.com/" ignore-error="false" />
        </send-request>
        <!--
          Classify source failures before parsing:
          null means the request failed or timed out, 404 means no profile exists,
          and other non-200 responses are temporary source failures.
        -->
        <choose>
          <!-- Condition: send-request produced no response, which represents a timeout or transport failure. -->
          <when condition='@(!context.Variables.ContainsKey("profileResponse") || context.Variables["profileResponse"] == null)'>
            <return-response>
              <set-status code="503" reason="Service Unavailable" />
              <set-header name="Content-Type" exists-action="override">
                <value>application/json</value>
              </set-header>
              <set-body>@("{\"error\":{\"code\":\"RoutingDependencyUnavailable\",\"message\":\"The service is temporarily unavailable.\",\"correlationId\":\"" + context.RequestId + "\"}}")</set-body>
            </return-response>
          </when>
          <!-- Condition: Table Storage returned 404, so the requested profile does not exist. -->
          <when condition='@(((IResponse)context.Variables["profileResponse"]).StatusCode == 404)'>
            <return-response>
              <set-status code="500" reason="Internal Server Error" />
              <set-header name="Content-Type" exists-action="override">
                <value>application/json</value>
              </set-header>
              <set-body>@("{\"error\":{\"code\":\"RoutingConfigurationUnavailable\",\"message\":\"The request could not be processed.\",\"correlationId\":\"" + context.RequestId + "\"}}")</set-body>
            </return-response>
          </when>
          <!-- Condition: any remaining non-200 result is a temporary Table service or authorization failure. -->
          <when condition='@(((IResponse)context.Variables["profileResponse"]).StatusCode != 200)'>
            <return-response>
              <set-status code="503" reason="Service Unavailable" />
              <set-header name="Content-Type" exists-action="override">
                <value>application/json</value>
              </set-header>
              <set-body>@("{\"error\":{\"code\":\"RoutingDependencyUnavailable\",\"message\":\"The service is temporarily unavailable.\",\"correlationId\":\"" + context.RequestId + "\"}}")</set-body>
            </return-response>
          </when>
        </choose>
        <!--
          Validate required version-one fields and ignore unknown optional properties.
          MaxTpm is row-configurable: any positive Int32 value is accepted and applied.
          The result is compact JSON containing only schemaVersion, backendId, and maxTpm.
        -->
        <set-variable name="normalizedProfile" value='@{
          var entity = ((IResponse)context.Variables["profileResponse"]).Body.As&lt;Newtonsoft.Json.Linq.JObject&gt;(preserveContent: true);
          var schemaVersion = entity["SchemaVersion"];
          var backendId = entity["BackendId"];
          var maxTpm = entity["MaxTpm"];
          var valid = entity["PartitionKey"]?.ToString() == "profiles-v1"
            &amp;&amp; entity["RowKey"]?.ToString() == (string)context.Variables["profileKey"]
            &amp;&amp; schemaVersion != null
            &amp;&amp; schemaVersion.Type == Newtonsoft.Json.Linq.JTokenType.Integer
            &amp;&amp; (int)schemaVersion == 1
            &amp;&amp; backendId != null
            &amp;&amp; backendId.Type == Newtonsoft.Json.Linq.JTokenType.String
            &amp;&amp; System.Text.RegularExpressions.Regex.IsMatch(backendId.ToString(), "^[A-Za-z0-9._-]{1,80}$")
            &amp;&amp; maxTpm != null
            &amp;&amp; maxTpm.Type == Newtonsoft.Json.Linq.JTokenType.Integer
            &amp;&amp; (long)maxTpm > 0
            &amp;&amp; (long)maxTpm &lt;= System.Int32.MaxValue;
          if (!valid)
          {
            return "";
          }
          return new Newtonsoft.Json.Linq.JObject(
            new Newtonsoft.Json.Linq.JProperty("schemaVersion", 1),
            new Newtonsoft.Json.Linq.JProperty("backendId", backendId.ToString()),
            new Newtonsoft.Json.Linq.JProperty("maxTpm", (int)maxTpm)
          ).ToString(Newtonsoft.Json.Formatting.None);
        }' />
        <!-- Stop before caching or routing when normalization reports any schema or field validation failure. -->
        <choose>
          <!-- Condition: validation returned the empty sentinel instead of a safe normalized profile. -->
          <when condition='@((string)context.Variables["normalizedProfile"] == "")'>
            <return-response>
              <set-status code="500" reason="Internal Server Error" />
              <set-header name="Content-Type" exists-action="override">
                <value>application/json</value>
              </set-header>
              <set-body>@("{\"error\":{\"code\":\"RoutingConfigurationUnavailable\",\"message\":\"The request could not be processed.\",\"correlationId\":\"" + context.RequestId + "\"}}")</set-body>
            </return-response>
          </when>
        </choose>
        <!-- Cache storage is asynchronous; this request continues with normalizedProfile directly. -->
        <cache-store-value key='@((string)context.Variables["profileKey"])' value='@((string)context.Variables["normalizedProfile"])' duration="{{ProfileCacheTtlSeconds}}" caching-type="internal" />
      </otherwise>
    </choose>
    <!-- Read the normalized application values once; both cache paths converge here. -->
    <set-variable name="backendId" value='@((string)Newtonsoft.Json.Linq.JObject.Parse((string)context.Variables["normalizedProfile"])["backendId"])' />
    <set-variable name="maxTpm" value='@((int)Newtonsoft.Json.Linq.JObject.Parse((string)context.Variables["normalizedProfile"])["maxTpm"])' />
    <!--
      Apply the exact MaxTpm read from this profile row. The Profile Key is also
      the counter key, so requests resolving to different rows have independent limits.
    -->
    <llm-token-limit tokens-per-minute='@((int)context.Variables["maxTpm"])' counter-key='@((string)context.Variables["profileKey"])' estimate-prompt-tokens="true" />
    <!-- Authenticate to Foundry and route through the backend entity selected by the profile. -->
    <set-header name="api-key" exists-action="delete" />
    <authentication-managed-identity resource="https://cognitiveservices.azure.com" output-token-variable-name="foundryAccessToken" ignore-error="false" />
    <set-header name="Authorization" exists-action="override">
      <value>@("Bearer " + (string)context.Variables["foundryAccessToken"])</value>
    </set-header>
    <set-query-parameter name="api-version" exists-action="override">
      <value>__OPENAI_API_VERSION__</value>
    </set-query-parameter>
    <set-backend-service backend-id='@((string)context.Variables["backendId"])' id="apply-profile-backend" />
  </inbound>
  <backend>
    <forward-request />
  </backend>
  <outbound>
    <base />
    <!-- Non-secret test diagnostics are disabled by default and enabled temporarily by the smoke test. -->
    <choose>
      <!-- Condition: the deployment-controlled test switch explicitly permits diagnostic response headers. -->
      <when condition='@({{EnableGatewayDebugHeaders}})'>
        <set-header name="X-Profile-Cache" exists-action="override">
          <value>@((string)context.Variables["profileCacheOutcome"])</value>
        </set-header>
        <set-header name="X-Backend-Id" exists-action="override">
          <value>@((string)context.Variables["backendId"])</value>
        </set-header>
        <set-header name="X-Token-Limit-Tpm" exists-action="override">
          <value>@(((int)context.Variables["maxTpm"]).ToString())</value>
        </set-header>
      </when>
    </choose>
  </outbound>
  <on-error>
    <base />
    <!-- Map known miss throttling separately, then fail closed for every other policy execution error. -->
    <choose>
      <!-- Condition: the per-Profile-Key cold lookup guard rejected an excess cache miss. -->
      <when condition='@(context.LastError.PolicyId == "profile-miss-rate-limit")'>
        <return-response>
          <set-status code="429" reason="Too Many Requests" />
          <set-header name="Content-Type" exists-action="override">
            <value>application/json</value>
          </set-header>
          <set-body>@("{\"error\":{\"code\":\"TooManyRequests\",\"message\":\"Too many requests were received.\",\"correlationId\":\"" + context.RequestId + "\"}}")</set-body>
        </return-response>
      </when>
      <!-- Fallback: hide backend-application, parsing, identity, and other internal policy failure details. -->
      <otherwise>
        <return-response>
          <set-status code="500" reason="Internal Server Error" />
          <set-header name="Content-Type" exists-action="override">
            <value>application/json</value>
          </set-header>
          <set-body>@("{\"error\":{\"code\":\"RoutingConfigurationUnavailable\",\"message\":\"The request could not be processed.\",\"correlationId\":\"" + context.RequestId + "\"}}")</set-body>
        </return-response>
      </otherwise>
    </choose>
  </on-error>
</policies>
