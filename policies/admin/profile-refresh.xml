<policies>
  <!--
    Profile Refresh pipeline:
    1. Validate one Profile Key from the operation path.
    2. Reuse the runtime Table read and normalization contract.
    3. Submit the validated normalized profile to APIM's built-in cache.
    4. Return Accepted without claiming immediate cache visibility.
  -->
  <inbound>
    <base />
    <set-variable name="profileKey" value='@(context.Request.MatchedParameters.GetValueOrDefault("profileKey", ""))' />
    <!-- Guard the refresh pipeline so invalid Profile Keys never reach Table Storage. -->
    <choose>
      <!-- Condition: the path value contains characters or length outside the Profile Key contract. -->
      <when condition='@(!System.Text.RegularExpressions.Regex.IsMatch((string)context.Variables["profileKey"], "^[A-Za-z0-9._-]{1,128}$"))'>
        <return-response>
          <set-status code="400" reason="Bad Request" />
          <set-header name="Content-Type" exists-action="override">
            <value>application/json</value>
          </set-header>
          <set-body>@("{\"error\":{\"code\":\"InvalidRequest\",\"message\":\"The request is invalid.\",\"correlationId\":\"" + context.RequestId + "\"}}")</set-body>
        </return-response>
      </when>
    </choose>
    <include-fragment fragment-id="resolve-profile" />
    <return-response>
      <set-status code="202" reason="Accepted" />
      <set-header name="Content-Type" exists-action="override">
        <value>application/json</value>
      </set-header>
      <set-body>@("{\"status\":\"accepted\",\"message\":\"The profile refresh was accepted.\",\"correlationId\":\"" + context.RequestId + "\"}")</set-body>
    </return-response>
  </inbound>
  <backend>
    <base />
  </backend>
  <outbound>
    <base />
  </outbound>
  <on-error>
    <base />
    <!-- Preserve product-scoped subscription rejection while sanitizing all unexpected policy failures. -->
    <choose>
      <!-- Condition: APIM rejected a missing, invalid, or expired subscription before the admin policy ran. -->
      <when condition='@(context.LastError.Reason == "SubscriptionKeyNotFound" || context.LastError.Reason == "SubscriptionKeyInvalid" || context.LastError.Reason == "SubscriptionKeyExpired")'>
        <return-response>
          <set-status code="403" reason="Forbidden" />
          <set-header name="Content-Type" exists-action="override">
            <value>application/json</value>
          </set-header>
          <set-body>@("{\"error\":{\"code\":\"Forbidden\",\"message\":\"The request is not authorized.\",\"correlationId\":\"" + context.RequestId + "\"}}")</set-body>
        </return-response>
      </when>
      <!-- Fallback: hide parsing, identity, cache, and other internal policy failure details. -->
      <otherwise>
        <return-response>
          <set-status code="500" reason="Internal Server Error" />
          <set-header name="Content-Type" exists-action="override">
            <value>application/json</value>
          </set-header>
          <set-body>@("{\"error\":{\"code\":\"RoutingConfigurationUnavailable\",\"message\":\"The request could not be processed.\",\"correlationId\":\"" + context.RequestId + "\"}}")</set-body>
        </return-response>
      </otherwise>
    </choose>
  </on-error>
</policies>
